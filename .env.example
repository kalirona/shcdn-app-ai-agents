# ===========================================
# Agent AI - Environment Configuration
# ===========================================

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Agent AI"

# --- Widget ---
# Comma-separated list of origins allowed to call the public widget chat/config APIs.
ALLOWED_WIDGET_ORIGINS=http://localhost:3000

# --- Public Chat API ---
# Shared server-only secret required to call /api/chat (used by external integrations).
# Generate with: openssl rand -base64 32
CHAT_API_SECRET=

# --- Authentication provider ---
# Server-only. "directus" (legacy) or "supabase" (new identity provider).
# An unset or invalid value is a fatal configuration error (the app refuses to
# start in production).
AUTH_PROVIDER=directus

# Server-only. Required when AUTH_PROVIDER=directus. Encrypts the httpOnly
# Directus session cookie (AES-256-GCM). Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Supabase (required when AUTH_PROVIDER=supabase) ---
# NEXT_PUBLIC_* are safe in the browser (they are the publishable URL + anon
# key). SUPABASE_SERVICE_ROLE_KEY is server-only and must NEVER be exposed with
# a NEXT_PUBLIC_ prefix or referenced from browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Directus) ---
# Server-only. DIRECTUS_URL is required in both modes; DIRECTUS_TOKEN is the
# server-side data/admin token (never expose with NEXT_PUBLIC_).
DIRECTUS_URL=
DIRECTUS_TOKEN=

# --- AI Provider ---
# Which provider the legacy env-driven path uses ("openai", "anthropic",
# "openrouter", "gemini", "glm", "together", "groq", "ollama", "custom").
# The platform gateway (Admin → Settings → AI Providers) overrides this when
# an enabled provider with a decrypted key exists.
AI_PROVIDER=openrouter
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- AI Provider secret encryption ---
# Server-only. REQUIRED before saving any provider API key in Admin → Settings.
# Encrypts provider API keys at rest (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Never expose with a NEXT_PUBLIC_ prefix. Rotating this value invalidates all
# previously saved provider keys (they must be re-entered).
AI_API_KEY_ENCRYPTION_KEY=
OPENROUTER_API_KEY=

# --- Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Payments ---
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LS_STARTER_VARIANT=
LS_BUSINESS_VARIANT=
LS_PRO_VARIANT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_STARTER_PLAN_ID=
PAYPAL_BUSINESS_PLAN_ID=
PAYPAL_PRO_PLAN_ID=

# --- Email ---
RESEND_API_KEY=

# --- Monitoring ---
SENTRY_DSN=
